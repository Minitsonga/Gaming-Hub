{
  "name": "gaming-hub",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "backend/gateway",
    "backend/services/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=backend/gateway",
    "dev:auth": "npm run dev --workspace=backend/services/auth-service",
    "dev:catalog": "npm run dev --workspace=backend/services/catalog-service",
    "dev:roguelike": "npm run dev --workspace=backend/services/roguelike-service",
    "dev:analytics": "npm run dev --workspace=backend/services/analytics-service",
    "release": "node scripts/release.js",
    "lint": "eslint backend",
    "lint:fix": "eslint backend --fix",
    "format": "prettier --write \"backend/**/*.ts\"",
    "format:check": "prettier --check \"backend/**/*.ts\"",
    "load-test": "k6 run load-tests/health.js",
    "load-test:health": "k6 run load-tests/health.js",
    "load-test:graphql": "k6 run load-tests/graphql.js",
    "load-test:load": "k6 run load-tests/load.js",
    "load-test:stress": "k6 run load-tests/stress.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.55.0"
  }
}
