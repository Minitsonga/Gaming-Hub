{
  "name": "gaming-hub",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "backend/gateway",
    "backend/services/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=backend/gateway",
    "dev:auth": "npm run dev --workspace=backend/services/auth-service",
    "dev:catalog": "npm run dev --workspace=backend/services/catalog-service",
    "dev:roguelike": "npm run dev --workspace=backend/services/roguelike-service",
    "dev:analytics": "npm run dev --workspace=backend/services/analytics-service",
    "dev:gateway:delayed": "node -e \"setTimeout(() => process.exit(0), 8000)\" && npm run dev:gateway",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently -k -n auth,catalog,roguelike,analytics,gateway,frontend -c blue,green,magenta,cyan,yellow,white \"npm run dev:auth\" \"npm run dev:catalog\" \"npm run dev:roguelike\" \"npm run dev:analytics\" \"npm run dev:gateway:delayed\" \"npm run dev:frontend\"",
    "release": "node scripts/release.js",
    "lint": "eslint backend",
    "lint:fix": "eslint backend --fix",
    "format": "prettier --write \"backend/**/*.ts\"",
    "format:check": "prettier --check \"backend/**/*.ts\"",
    "load-test": "k6 run load-tests/health.js",
    "load-test:health": "k6 run load-tests/health.js",
    "load-test:graphql": "k6 run load-tests/graphql.js",
    "load-test:load": "k6 run load-tests/load.js",
    "load-test:stress": "k6 run load-tests/stress.js",
    "health:smoke": "node scripts/health-smoke.mjs",
    "reliability:check": "node scripts/reliability-check.mjs",
    "deploy:webgl": "node scripts/deploy-unity-webgl.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.55.0"
  }
}
